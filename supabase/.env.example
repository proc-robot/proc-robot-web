# Read by the Supabase CLI (config.toml → env(...)). Copy to supabase/.env.
# The Google OAuth client for local development (TASKS_SECONDARY.md T4.2.1; Google
# sign-in is off until Phase 4, so these can stay empty). Its Authorized
# redirect URI is http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
