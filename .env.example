# Copy to `.env.local` for local development.

# The public site's own origin: the base for every canonical, og:url, og:image,
# sitemap URL and JSON-LD @id. NEXT_PUBLIC_* is inlined by the bundler, so this
# is fixed at BUILD time — a build is tied to the origin it was built with.
NEXT_PUBLIC_SITE_URL="https://proc-robot.com"

# Search-engine indexing switch, read per request by src/app/robots.ts.
# Indexing is opt-in: anything other than "true" serves `Disallow: /`, so
# preview and staging deployments stay out of the index.
# PRODUCTION MUST SET THIS TO "true" — verify after deploy with:
#   curl -s https://proc-robot.com/robots.txt
SITE_INDEXABLE="false"

# Supabase project URL + publishable key. Only public values belong in the
# web app; the service-role / secret key never goes here (PLAN.md → Secrets).
# Local values: `supabase status -o env` (API_URL and PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
